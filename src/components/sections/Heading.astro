---
import type { Showing } from '../../../definition';
// A section's heading and introduction.
const { section } = Astro.props as {
  section: Pick<Showing, 'heading' | 'intro'>;
};
---

<div class="max-w-2xl">
  <h2 class="text-3xl font-semibold tracking-tight">{section.heading}</h2>
  <p class="mt-3 text-lg text-muted-foreground">{section.intro}</p>
</div>
