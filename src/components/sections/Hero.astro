---
import type { Section } from '../../../definition';
import { linkValue, releaseUrl, rootFrom, sizeOf } from '../../data';
// Opens every page: its heading, an introduction, a call to action and an
// image.
const { section, from } = Astro.props as {
  section: Extract<Section, { type: 'hero' }>;
  from: string;
};
---

<section class="container-page grid gap-10 py-14 md:grid-cols-2 md:items-center md:py-20">
  <div class="flex flex-col gap-6">
    <h1 class="text-4xl font-semibold leading-[1.1] tracking-tight md:text-6xl">
      {section.heading}
    </h1>
    <p class="max-w-prose text-lg text-muted-foreground">{section.body}</p>
    <a class="button" href={linkValue(from)(section.cta)}>
      {section.ctaLabel}
    </a>
  </div>
  <img
    class="w-full rounded-3xl object-cover"
    src={releaseUrl(section.image.asset, rootFrom(from))}
    alt={section.image.alt}
    {...sizeOf(section.image.asset)}
  />
</section>
