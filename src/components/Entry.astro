---
import type { Page, Post } from '../../schema';
import RichText from '@briskcms/astro/RichText.astro';
import Layout from '../layouts/Layout.astro';
import Hero from './sections/Hero.astro';
import Services from './sections/Services.astro';
import Team from './sections/Team.astro';
import Testimonials from './sections/Testimonials.astro';
import Pricing from './sections/Pricing.astro';
import Gallery from './sections/Gallery.astro';
import Contact from './sections/Contact.astro';
import CallToAction from './sections/CallToAction.astro';
import Text from './sections/Text.astro';
import {
  build,
  authorOf,
  linkFrom,
  longDate,
  releaseUrl,
  rootFrom,
  sizeOf,
} from '../data';
// A page (its sections, opened by the hero), or a post at /news/<slug>/:
// its headline, summary, cover and byline, then its rich-text body. Either
// ends with its questions and answers.
const { page, from, post } = Astro.props as {
  page: Page | Post;
  from: string;
  post?: boolean;
};
const base = rootFrom(from);
const linkTo = linkFrom(from);
const article = post ? (page as Post) : undefined;
const hero = article
  ? { image: article.cover }
  : (page as Page).sections.find((s) => s.type === 'hero')!;
const author = article && authorOf(article.author);
const nodes = build.entryNodes(page, from, post);
---

<Layout
  title={page.title}
  description={page.description}
  from={from}
  ogType={article ? 'article' : 'website'}
  image={hero.image}
  nodes={nodes}
>
  {article ? (
    <article>
      <header class="container-page grid gap-10 py-14 md:grid-cols-2 md:items-center">
        <div class="flex flex-col gap-5">
          <h1 class="text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
            {article.headline}
          </h1>
          <p class="text-lg text-muted-foreground">{article.summary}</p>
          <p class="text-sm text-muted-foreground">
            {author!.name}
            {article.publishedAt && (
              <>
                {' · '}
                <time datetime={article.publishedAt}>
                  {longDate(article.publishedAt)}
                </time>
              </>
            )}
          </p>
        </div>
        <img
          class="w-full rounded-3xl object-cover"
          src={releaseUrl(article.cover.asset, base)}
          alt={article.cover.alt}
          {...sizeOf(article.cover.asset)}
        />
      </header>
      {article.body.length > 0 && (
        <div class="container-page">
          <div class="mx-auto max-w-prose space-y-5 text-lg leading-relaxed [&_a]:text-primary [&_a]:underline [&_blockquote]:border-l-4 [&_blockquote]:border-border [&_blockquote]:pl-4 [&_h2]:pt-4 [&_h2]:text-2xl [&_h2]:font-semibold [&_h3]:text-xl [&_h3]:font-semibold [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:pl-6">
            <RichText blocks={article.body} linkTo={linkTo} />
          </div>
        </div>
      )}
    </article>
  ) : (
    (page as Page).sections.map((s) =>
      s.type === 'hero' ? (
        <Hero section={s} from={from} />
      ) : s.type === 'services' ? (
        <Services section={s} from={from} />
      ) : s.type === 'team' ? (
        <Team section={s} from={from} />
      ) : s.type === 'testimonials' ? (
        <Testimonials section={s} />
      ) : s.type === 'pricing' ? (
        <Pricing section={s} from={from} />
      ) : s.type === 'gallery' ? (
        <Gallery section={s} from={from} />
      ) : s.type === 'contact' ? (
        <Contact section={s} from={from} />
      ) : s.type === 'call-to-action' ? (
        <CallToAction section={s} from={from} />
      ) : (
        <Text section={s} />
      ),
    )
  )}
  {page.faqs.length > 0 && (
    <section class="container-page py-14" id="faq">
      <h2 class="text-3xl font-semibold tracking-tight">Common questions</h2>
      <div class="mt-6 divide-y divide-border rounded-3xl border border-border bg-card">
        {page.faqs.map((f) => (
          <details class="p-6">
            <summary class="cursor-pointer font-medium">{f.question}</summary>
            <p class="mt-3 text-muted-foreground">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</Layout>
